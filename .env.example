# Copy to .env and fill in. Never commit .env.

# Required for OpenAI embeddings, answers and scans (not needed for `chat-insight demo`)
OPENAI_API_KEY=

# What the corpus is — injected into every prompt so the analyst persona fits the data
CORPUS_DESCRIPTION=a WhatsApp group of UK NHS clinicians discussing AI, digital health and their day-to-day work

# Export
WHATSAPP_DB=./whatsapp-mcp/whatsapp-bridge/store/messages.db
GROUP_NAME=

# Where generated data lives (gitignored)
DATA_DIR=./data

# Chunking
CHUNK_SIZE=30
STRIDE=30

# Models
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
CHAT_MODEL=gpt-4o
FALLBACK_CHAT_MODEL=gpt-4o-mini
MAP_MODEL=gpt-4o-mini

# Retrieval
CHROMA_COLLECTION=chat_chunks
TOP_N=8
